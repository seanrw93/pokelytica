generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  FREE
  PREMIUM
}

// --- Auth.js adapter models (standard shapes) ---

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  tier          Tier      @default(FREE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  teams         Team[]
  battleRecords BattleRecord[]
  usage         Usage?
}

model Team {
  id        String   @id @default(cuid())
  userId    String
  name      String
  // Pokemon slots snapshotted as JSON rather than normalized into their own
  // table/relation — a saved team is a self-contained blob, not a foreign key graph.
  slots     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Stub — phase 2 fills in the curated gym leader / E4 / rival roster.
model Trainer {
  id        String   @id @default(cuid())
  name      String
  title     String?
  team      Json
  spriteRef String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  battleRecords BattleRecord[]
}

model BattleRecord {
  id        String   @id @default(cuid())
  userId    String?
  trainerId String?
  // teamA/teamB are snapshotted as JSON (not FKs to Team) so editing or
  // deleting a saved team later never rewrites past battle history.
  teamA     Json
  teamB     Json
  result    String
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  trainer Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
}

model Usage {
  id     String @id @default(cuid())
  userId String @unique

  aiCallsToday Int @default(0)
  aiCallsWeek  Int @default(0)

  // Counters are reset lazily on read (compare now() to these) rather than via a cron job.
  dayResetAt  DateTime @default(now())
  weekResetAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
