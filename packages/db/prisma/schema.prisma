generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  FREE
  PREMIUM
}

// --- Better Auth adapter models ---
// Shapes generated by `npx @better-auth/cli generate` against apps/web/lib/auth.ts
// (social providers + magicLink plugin) — do not hand-edit field names/types
// without regenerating, Better Auth's runtime queries expect this exact shape.

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// --- App models ---

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  tier          Tier     @default(FREE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
  accounts      Account[]
  teams         Team[]
  battleRecords BattleRecord[]
  usage         Usage?

  @@map("user")
}

model Team {
  id        String   @id @default(cuid())
  userId    String
  name      String
  // Pokemon slots snapshotted as JSON rather than normalized into their own
  // table/relation — a saved team is a self-contained blob, not a foreign key graph.
  slots     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Trainer {
  id         String   @id @default(cuid())
  name       String   @unique
  title      String
  generation Int
  // Six PokemonSet-shaped entries (same shape as Team.slots) — snapshotted
  // JSON, not normalized, for the same reason Team.slots isn't.
  team       Json
  // Key into @pkmn/img's trainer avatar sprite set (see packages/db/prisma/trainerSpriteIds.ts).
  spriteId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  battleRecords BattleRecord[]
}

model BattleRecord {
  id        String   @id @default(cuid())
  userId    String?
  trainerId String?
  // teamA/teamB are snapshotted as JSON (not FKs to Team) so editing or
  // deleting a saved team later never rewrites past battle history.
  teamA     Json
  teamB     Json
  result    String
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  trainer Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
}

model Usage {
  id     String @id @default(cuid())
  userId String @unique

  aiCallsToday Int @default(0)
  aiCallsWeek  Int @default(0)

  // Counters are reset lazily on read (compare now() to these) rather than via a cron job.
  dayResetAt  DateTime @default(now())
  weekResetAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
